# ─────────────────────────────────────────────────────────────────────────────
# TalkNest BD — environment variables
#
#   Copy to .env.local for development (Next.js reads .env, .env.local and
#   .env.[mode]; .env.local wins over .env):
#     PowerShell:  Copy-Item .env.example .env.local
#     bash:        cp .env.example .env.local
#
# Never commit real secrets. .env.local / .env.production are gitignored.
# Architecture and upload rules: docs/ARCHITECTURE.md
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Local dev. Production: https://talknestbd.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database: Neon Postgres ──────────────────────────────────────────────────
# Neon dashboard → your project → Connect → "Connection string".
# Pick the region closest to your readers: ap-southeast-1 (Singapore).
#
# 1) DATABASE_URL  → POOLED host, contains "-pooler". Used by the running app.
# 2) DATABASE_URL_UNPOOLED → DIRECT host, no "-pooler". Used by drizzle-kit only.
#
# Keep sslmode=require. Neon rejects plaintext connections.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/talknest?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/talknest?sslmode=require"

# If you install Neon's Vercel/Netlify integration it injects these names instead:
# POSTGRES_URL=                 # pooled
# POSTGRES_URL_NON_POOLING=     # direct, for migrations
# POSTGRES_PRISMA_URL=          # pooled, Prisma flavour
# The app reads DATABASE_URL first, so either name the variable explicitly or
# map the platform name onto DATABASE_URL in src/lib/db/index.ts.

# ── Auth: Better Auth (LATER PHASE — not wired up yet, leave blank) ──────────
# Authentication is not implemented yet. These are documented now so the values
# are known when that phase starts; nothing reads them today.
#
# BETTER_AUTH_SECRET signs/encrypts sessions and cookies.
# 32+ random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this invalidates every existing session. Required in production —
# Better Auth refuses to boot without it.
BETTER_AUTH_SECRET=

# Public origin of the app. This is the base for OAuth callbacks and cookies.
#   dev:        http://localhost:3000
#   production: https://talknestbd.com
# Set this explicitly. Do not rely on request inference behind Nginx.
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (login with Google) ─────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
#   → Create credentials → OAuth client ID → Application type: Web application
#
# Authorized JavaScript origins:
#   http://localhost:3000
#   https://talknestbd.com
#
# Authorized redirect URIs (must match exactly, including the path):
#   http://localhost:3000/api/auth/callback/google
#   https://talknestbd.com/api/auth/callback/google
#
# The callback path is Better Auth's default: {BETTER_AUTH_URL}/api/auth/callback/google
# Scopes used: openid, email, profile (defaults — no extra config needed).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth consent screen: while the app is in "Testing", only added test users can
# sign in. Publish the app before launch, or Google sign-in will fail for the public.

# ── Alternative: Neon Managed Better Auth (NOT chosen — see docs §3.6) ───────
# If you switch to Neon's managed auth, these two replace BETTER_AUTH_* + GOOGLE_*:
# NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.ap-southeast-1.aws.neon.tech/talknest/auth
# NEON_AUTH_COOKIE_SECRET=
# The Google redirect URI then becomes {NEON_AUTH_BASE_URL}/callback/google,
# not your app's /api/auth/callback/google. Identity tables live in the
# `neon_auth` schema; your app tables reference their user id.

# ── File storage: LOCAL DISK (images, audio, video) ──────────────────────────
# Driver: local | s3
STORAGE_DRIVER=local

# Persistent, writable directory OUTSIDE the build output.
#   dev:            ./uploads
#   prod (VPS):     /data/uploads      (mounted Docker volume)
#   never:          ./public/uploads   (public/ is copied at build time)
UPLOAD_DIR=./uploads

# Public URL prefix that maps to UPLOAD_DIR.
# Served by Nginx in production (recommended) or by the /api/media route handler.
PUBLIC_MEDIA_URL=/media

# Upload size limits in megabytes — enforced server-side in the upload route.
# Image: sharp-resized on upload.  Audio/Video: streamed to disk, not buffered.
MAX_IMAGE_MB=10
MAX_AUDIO_MB=25
MAX_VIDEO_MB=200
MAX_PDF_MB=15


# ── One-time seed (used by src/lib/db/seed.ts, then remove) ──────────────────
SEED_ADMIN_EMAIL=admin@talknestbd.com
SEED_ADMIN_PASSWORD=